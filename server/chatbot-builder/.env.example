# Reference template. For local Wrangler use, copy values to .dev.vars.
# Never commit .dev.vars or paste secret values into source code/chat.
GEMINI_KEY_1=
GEMINI_KEY_2=
GEMINI_KEY_3=
GEMINI_KEY_4=
GEMINI_KEY_5=

# Model identifiers are configuration, not hardcoded in application code.
GEMINI_MODEL_INTERVIEW=gemini-3.8-flash
GEMINI_MODEL_EXTRACT=gemini-3.8-flash
GEMINI_MODEL_QUESTIONS=gemini-3.8-flash
GEMINI_MODEL_BUILD=gemini-3.8-flash
GEMINI_MODEL_TEST=gemini-3.8-flash
GEMINI_MODEL_CHAT=gemini-3.8-flash

CB_ALLOWED_ORIGINS=https://multigameweb.github.io,http://localhost:8000,http://127.0.0.1:8000
CB_ENABLE_ADMIN_TEST=false
CB_OWNER_DAILY_LIMIT=200

# OIDC login verification. Leave unset until an actual identity provider/client is configured.
# Issuer, JWKS URL and audience must match the provider's token contract.
AUTH_ISSUER=
AUTH_JWKS_URL=
AUTH_AUDIENCE=
# Comma-separated immutable OIDC "sub" values, never email addresses.
AUTH_ADMIN_SUBJECTS=
