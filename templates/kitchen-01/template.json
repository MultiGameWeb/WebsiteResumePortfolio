    "faqs": [
      {
        "id": "f1",
        "question": "How do I place a food order?",
        "answer": "Choose dishes or a meal plan, fill in the order enquiry and send the details through WhatsApp. The kitchen will confirm the menu, delivery area, total and payment method.",
        "enabled": true
      },
      {
        "id": "f2",
        "question": "Can I order food for a group or office?",
        "answer": "Yes. Share the number of people, date, delivery location and menu preference for a bulk quotation.",
        "enabled": true
      },
      {
        "id": "f3",
        "question": "Do you provide party and event catering?",
        "answer": "Catering is available by prior enquiry. Menu, guest count, service staff and venue requirements will be discussed before a quotation is shared.",
        "enabled": true
      },
      {
        "id": "f4",
        "question": "Can I subscribe to daily or weekly meals?",
        "answer": "Meal plans can be requested for weekly, monthly or custom schedules. The kitchen will confirm service days, menu rotation and delivery arrangements.",
        "enabled": true
      },
      {
        "id": "f5",
        "question": "Can you accommodate allergies or dietary preferences?",
        "answer": "Share all dietary requirements and allergies before placing an order. The kitchen must confirm ingredients and cross-contact precautions for each request.",
        "enabled": true
      },
      {
        "id": "f6",
        "question": "Are the listed prices final?",
        "answer": "Prices are indicative. Final pricing may vary by portion size, customisation, order quantity, delivery distance and taxes. Confirm before payment.",
        "enabled": true
      }
    ],
