      },
      {
        "id": "f2",
        "question": "Do you deliver?",
        "answer": "Yes, within the areas listed in the order form. Delivery is free on orders above ₹499; a small charge applies to smaller orders.",
        "enabled": true
      },
      {
        "id": "f3",
        "question": "How can I pay?",
        "answer": "UPI, cash or card. For delivery orders you can pay on delivery.",
        "enabled": true
      },
      {
        "id": "f4",
        "question": "What if an item is not in stock?",
        "answer": "We’ll tell you before packing and suggest a similar item. Nothing is added without your okay.",
        "enabled": true
      },
      {
        "id": "f5",
        "question": "Can I return an item?",
