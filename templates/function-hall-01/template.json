    "faqs": [
      {
        "id": "q1",
        "question": "How do I check hall availability?",
        "answer": "Send your event date, preferred hall and event timing through the enquiry form. The venue manager will check the current calendar and respond.",
        "enabled": true
      },
      {
        "id": "q2",
        "question": "Can I book the hall for half a day?",
        "answer": "Half-day, evening and full-day packages may be available depending on the hall and date. Confirm the exact slot and access time in writing.",
        "enabled": true
      },
      {
        "id": "q3",
        "question": "Is catering included in the hall rent?",
        "answer": "Catering inclusions vary by package. Ask for the current menu, per-plate rates and outside-caterer policy before confirming.",
        "enabled": true
      },
      {
        "id": "q4",
        "question": "Can I visit the function hall before booking?",
        "answer": "Yes. Request a site visit and the team will arrange a suitable appointment based on availability.",
        "enabled": true
      },
      {
        "id": "q5",
        "question": "Are decoration and sound systems included?",
        "answer": "Basic provisions and paid add-ons vary by hall and package. Confirm stage, décor, sound, LED and vendor arrangements in the quotation.",
        "enabled": true
      },
      {
        "id": "q6",
        "question": "When is the booking confirmed?",
