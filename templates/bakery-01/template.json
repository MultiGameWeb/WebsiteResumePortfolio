    "faqs": [
      {
        "id": "f1",
        "question": "Can every cake be made eggless?",
        "answer": "Yes. Every cake on the menu can be baked eggless. Choose “Eggless” in the order form or mention it on WhatsApp.",
        "enabled": true
      },
      {
        "id": "f2",
        "question": "How early should I order a custom cake?",
        "answer": "Please order at least one day in advance. For tiered or theme cakes, two to three days helps us get the design right. Message us about same-day options.",
        "enabled": true
      },
      {
        "id": "f3",
        "question": "Do you deliver?",
        "answer": "Yes, we deliver within nearby areas for a small charge based on distance. You can also pick up from the bakery.",
        "enabled": true
      },
      {
        "id": "f4",
        "question": "How do I pay for my order?",
        "answer": "Custom cakes are confirmed with an advance on UPI. The balance can be paid by UPI, card or cash at pickup or delivery.",
        "enabled": true
      },
      {
        "id": "f5",
        "question": "Can you write a message or add a photo on the cake?",
        "answer": "Yes. Add the message in the order form. For photo cakes, send the picture on WhatsApp after placing your order.",
        "enabled": true
      }
    ],
